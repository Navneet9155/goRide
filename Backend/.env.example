# ==============================
# SERVER
# ==============================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==============================
# DATABASE
# ==============================
MONGODB_URI=mongodb+srv://sankukumar999_db_user:ayush@cluster0.gkino7r.mongodb.net/

# ==============================
# JWT / AUTH
# ==============================
JWT_SECRET=c8c3b520c03a8dba1aeba4c2eecb1ae4409dfccdcbf214719cee5a4132744f5d
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=62e5bfb08d5d0f373693fd6e29447cef893a59d5fb56cce58de87c54f46cd17c
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false

# ==============================
# OPENSTREETMAP (NOMINATIM & OSRM)
# ==============================
# OpenStreetMap services are used for geocoding, reverse-geocoding, and OSRM routing.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=http://router.project-osrm.org

# ==============================
# ENHANCED PLACE SEARCH (optional, recommended for voice search)
# ==============================
# Without keys, app falls back to Nominatim (free but slower for voice queries).
# Adding either key gives faster autocomplete, fuzzy matching & GPS proximity bias.
#
# LocationIQ — https://locationiq.com/register (free 5,000 req/day, no credit card)
LOCATIONIQ_KEY=
#
# ==============================
# SPEECH-TO-TEXT (for Expo Go Voice Search)
# ==============================
# Groq Cloud Whisper API is 100% FREE (7,200 req/day, ultra-fast ~200ms latency)
# Get your free key instantly at: https://console.groq.com/keys
GROQ_API_KEY=
OPENAI_API_KEY=


# ==============================
# PAYMENTS (Razorpay)
# ==============================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==============================
# FARE CONFIG (defaults, overridable per vehicle type in fareConfig.js)
# ==============================
CURRENCY=INR

# ==============================
# AI VOICE BOOKING (optional)
# ==============================
# Enables natural Hindi/Hinglish intent extraction for the voice-booking preview.
# Without this key, the app uses its built-in command parser for simple requests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================
# WOMEN SAFETY / FEMALE DRIVER PRIORITY
# ==============================
FEMALE_DRIVER_PRIORITY=true
FEMALE_DRIVER_SEARCH_TIMEOUT=20
INITIAL_DRIVER_RADIUS_KM=5
MAX_DRIVER_RADIUS_KM=15
RADIUS_EXPANSION_STEP_KM=2
DRIVER_REQUEST_TIMEOUT_SECONDS=15

# ==============================
# OTP
# ==============================
OTP_LENGTH=4
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# ==============================
# SOS DELIVERY (optional, production)
# ==============================
# Evolution API instance must be connected to a dedicated WhatsApp Business number.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=replace_with_evolution_api_key
EVOLUTION_INSTANCE=goride-safety
# Gammu SMSD must be installed and connected to the GSM modem. Use an absolute .exe path on Windows if needed.
GAMMU_SMS_ENABLED=false
GAMMU_SMS_INJECT_COMMAND=gammu-smsd-inject
# OpenStreetMap Overpass endpoint used only at SOS time to find the nearest mapped station.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
POLICE_STATION_SEARCH_RADIUS_METRES=15000
